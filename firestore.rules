rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['f1b02310096@student.unram.ac.id', 'nahdah031@gmail.com', 'arifah031@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isNutritionist() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nutritionist') ||
        isAdmin()
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (
        (incoming().role == 'admin' && (request.auth.token.email in ['f1b02310096@student.unram.ac.id', 'nahdah031@gmail.com', 'arifah031@gmail.com'])) ||
        (incoming().role == 'nutritionist')
      );
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && (
        !incoming().diff(existing()).affectedKeys().hasAny(['role']) ||
        incoming().role == existing().role
      ));
    }

    match /menus/{menuId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /wards/{wardId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    function isValidTransaction(data) {
      return data.patientName is string && data.patientName.size() <= 100 &&
             data.patientAge is number &&
             data.patientGender in ['L', 'P'] &&
             data.mealTime in ['sarapan', 'selingan_1', 'makan_siang', 'selingan_2', 'makan_malam'] &&
             data.comstockScale is number && data.comstockScale >= 0 && data.comstockScale <= 5 &&
             (data.get('reason', null) == null || data.reason is string) &&
             (data.get('foodType', null) == null || data.foodType is string) &&
             data.staffId == request.auth.uid &&
             (data.get('staffName', null) == null || data.staffName is string) &&
             data.timestamp == request.time;
    }

    match /transactions/{transactionId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow update, delete: if isSignedIn();
    }
  }
}
